# Copia este archivo a .env.local y llena los valores. .env.local está en
# .gitignore: nunca lo subas al repo ni pegues sus valores en un chat.

# ── pey (cobros CoDi) — ver docs/pey-api.md ──────────────────────────────
# API key del portal de pey (sección Desarrollador). Va como Bearer token.
PEY_API_KEY=
# https://api.pey.mx — es el único ambiente que documenta pey.
PEY_API_URL=
# Secreto del webhook (whsec_…), lo muestra pey al crear el webhook.
PEY_WEBHOOK_SECRET=
# 1 = no llama a pey: cobros simulados y /api/dev/simulate-payment activo.
PEY_MOCK=

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta las políticas RLS: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# Dominio de producción, sin diagonal final. Ej. https://cuadra.vercel.app
NEXT_PUBLIC_APP_URL=
